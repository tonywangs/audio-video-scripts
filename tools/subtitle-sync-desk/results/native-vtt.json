[
  {
    "start": 107250,
    "end": 110500,
    "text": "This blade has a dark past."
  },
  {
    "start": 111800,
    "end": 115800,
    "text": "It has shed much innocent blood."
  },
  {
    "start": 118000,
    "end": 121450,
    "text": "You're a fool for traveling alone,\nso completely unprepared."
  },
  {
    "start": 121750,
    "end": 124800,
    "text": "You're lucky your blood's still flowing."
  },
  {
    "start": 125250,
    "end": 126300,
    "text": "Thank you."
  },
  {
    "start": 127500,
    "end": 129000,
    "text": "So..."
  },
  {
    "start": 129400,
    "end": 133800,
    "text": "What brings you to\nthe land of the gatekeepers?"
  },
  {
    "start": 135000,
    "end": 137500,
    "text": "I'm searching for someone."
  },
  {
    "start": 138000,
    "end": 142200,
    "text": "Someone very dear?\nA kindred spirit?"
  },
  {
    "start": 143400,
    "end": 145000,
    "text": "A dragon."
  },
  {
    "start": 148850,
    "end": 151750,
    "text": "A dangerous quest for a lone hunter."
  },
  {
    "start": 152950,
    "end": 155870,
    "text": "I've been alone for\nas long as I can remember."
  },
  {
    "start": 207250,
    "end": 210500,
    "text": "We're almost done. Shhh..."
  },
  {
    "start": 210750,
    "end": 213500,
    "text": "Hey, sit still."
  },
  {
    "start": 228250,
    "end": 232250,
    "text": "Good night, Scales."
  },
  {
    "start": 250350,
    "end": 253850,
    "text": "Get him, Scales! Come on!"
  },
  {
    "start": 265250,
    "end": 268250,
    "text": "Scales?"
  },
  {
    "start": 304000,
    "end": 307500,
    "text": "Yeah! Come on!"
  },
  {
    "start": 338750,
    "end": 342000,
    "text": "Scales!"
  },
  {
    "start": 445850,
    "end": 447500,
    "text": "I have failed."
  },
  {
    "start": 452800,
    "end": 456500,
    "text": "You've only failed to see..."
  },
  {
    "start": 457800,
    "end": 460500,
    "text": "These are dragon lands, Sintel."
  },
  {
    "start": 460850,
    "end": 464000,
    "text": "You are closer than you know."
  },
  {
    "start": 557600,
    "end": 559500,
    "text": "Scales!"
  },
  {
    "start": 621600,
    "end": 624000,
    "text": "Scales?"
  },
  {
    "start": 626200,
    "end": 629800,
    "text": "Scales..."
  }
]